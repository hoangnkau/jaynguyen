# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# database backups — never committed
/backups

# Scratch area for files that are on this machine on their way somewhere else —
# a CV PDF waiting to be uploaded through /admin, an export, a screenshot. Not
# source, not deliverable, and nothing here is needed to build the site.
/_local

# Locally-uploaded media.
#
# When BLOB_READ_WRITE_TOKEN is missing or a placeholder, Payload falls back to
# writing uploads here. Those files belong to whoever ran the dev server, not
# to the project: committing them puts binaries in the history, and they would
# not help in production anyway — Vercel's filesystem is read-only and
# ephemeral, so a committed image is one Payload cannot serve, update or
# delete. Real media lives in Vercel Blob.
/media
